# Notreve Chat Community

# Servidor HTTP
AGENTE_IA_ADDR=127.0.0.1:8080

# PostgreSQL fora do docker-compose:
# - AGENTE_IA_ADMIN_DB: conexão administrativa usada somente para migrations
#   e preparação de grants.
# - AGENTE_IA_DB: conexão runtime obrigatoriamente sem SUPERUSER/BYPASSRLS.
AGENTE_IA_ADMIN_DB=postgres://ADMIN:SENHA_ADMIN@127.0.0.1:5432/agente_ia?sslmode=disable
AGENTE_IA_DB=postgres://agente_app:SENHA_RUNTIME@127.0.0.1:5432/agente_ia?sslmode=disable

# Senha do super administrador criada apenas no primeiro bootstrap
AGENTE_IA_PASS=defina-uma-senha-forte

# Recuperação de MFA: informe o usuário (ex.: super_admin) para desativar a
# autenticação em duas etapas dele no próximo start. Remova depois de usar.
AGENTE_IA_RESET_MFA=

# Chave mestra obrigatória: exatamente 32 bytes codificados em base64.
# É usada para derivar, por domínio, as chaves de segredos internos, LGPD,
# credenciais de canais/provedores e segredos de assinatura de webhooks.
# Gere uma vez, mantenha somente no servidor e faça backup seguro.
AGENTE_IA_SECRETS_KEY=

# Chave HMAC obrigatória para validar webhooks recebidos da API Notreve WhatsApp.
WHATSAPP_HMAC_KEY=

# Infra opcional quando executando fora do docker-compose
AGENTE_IA_REDIS=
AGENTE_IA_RABBITMQ=

# Caminhos opcionais quando executando fora da imagem Docker
AGENTE_IA_WEBROOT=./web
AGENTE_IA_MIGRATIONS=./migrations

# Variáveis usadas pelo docker-compose. Nunca publique o .env real.
# POSTGRES_* pertencem somente à administração/migrations.
POSTGRES_USER=notreve_db_admin
POSTGRES_PASSWORD=defina-uma-senha-administrativa-forte
POSTGRES_DB=agente_ia

# A aplicação atende requisições somente com esta role. O bootstrap garante
# NOSUPERUSER, NOBYPASSRLS e concede apenas privilégios de runtime.
APP_DATABASE_USER=agente_app
APP_DATABASE_PASSWORD=defina-uma-senha-runtime-forte

RABBITMQ_DEFAULT_USER=defina-o-usuario
RABBITMQ_DEFAULT_PASS=defina-uma-senha-forte
